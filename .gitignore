# Secrets
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo

# Logs and OS files
npm-debug.log*
*.log
.DS_Store

# Victim app runtime state (regenerated by npm run victim:reset)
victim/.state.json

# Generated patched build (engine/fix.ts output)
victim/.server.fixed.ts

# Runtime state written by the generated eval apps (never committed)
eval/apps/**/data.json
eval/apps/**/db.json
eval/regression/**/data.json
eval/regression/**/db.json
